<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<!-- 跟 McpGateway 用同一版，兩邊的協定行為才一致 -->
		<PackageVersion Include="ModelContextProtocol" Version="2.3.0" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />

		<!-- 測試走 Microsoft.Testing.Platform（global.json），不需要 VSTest 的 Test.Sdk 和 runner -->
		<PackageVersion Include="xunit.v3" Version="4.0.2" />
	</ItemGroup>
</Project>
